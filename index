  .expediente{background:var(--paper); color:var(--ink); border-radius:3px; padding:28px 26px 24px; box-shadow:0 30px 60px rgba(0,0,0,0.35); position:relative; transform:rotate(1.2deg);}
  .expediente::after{content:""; position:absolute; top:16px; right:16px; width:48px; height:48px; border:1.5px dashed var(--gold); border-radius:50%;}
  .expediente-folio{font-family:'IBM Plex Mono', monospace; font-size:0.66rem; color:var(--slate); letter-spacing:0.06em;}
  .expediente-title{font-family:'Newsreader', serif; font-size:1.3rem; font-weight:600; color:var(--navy); margin:4px 0 16px;}
  .expediente-row{display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--line); font-size:0.85rem;}
  .expediente-row span:first-child{color:var(--slate);} .expediente-row span:last-child{font-weight:600; color:var(--navy);}
  .expediente-stamp{margin-top:18px; display:inline-flex; align-items:center; gap:8px; font-family:'IBM Plex Mono', monospace; font-size:0.66rem; color:var(--gold); border:1px solid var(--gold); padding:6px 12px; border-radius:20px;}
  .expediente-stamp .dot{width:6px; height:6px; border-radius:50%; background:var(--gold);}

  .trust-strip{background:var(--navy-deep); border-top:1px solid rgba(201,162,75,0.2); padding:20px 0;}
  .trust-row{display:flex; flex-wrap:wrap; gap:30px; justify-content:center;}
  .trust-item{font-family:'IBM Plex Mono', monospace; font-size:0.7rem; letter-spacing:0.08em; color:rgba(246,243,236,0.65); text-transform:uppercase;}

  section{padding:80px 0;}
  .section-eyebrow{font-family:'IBM Plex Mono', monospace; font-size:0.7rem; letter-spacing:0.12em; color:var(--gold); text-transform:uppercase; margin-bottom:14px;}
  h2{font-family:'Newsreader', serif; font-weight:500; font-size:clamp(1.5rem, 2.8vw, 2.1rem); color:var(--navy); margin-bottom:16px; max-width:24ch;}
  .lead{color:var(--slate); font-size:1rem; max-width:58ch; margin-bottom:40px;}

  .path-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  @media (max-width:800px){ .path-grid{grid-template-columns:1fr;} }
  .path-card{background:var(--paper); padding:30px 26px; text-decoration:none; color:inherit; transition:background .2s ease;}
  .path-card:hover{background:#fff;}
  .path-num{font-family:'IBM Plex Mono', monospace; font-size:0.72rem; color:var(--gold); margin-bottom:12px; display:block;}
  .path-card h3{font-family:'Newsreader', serif; font-size:1.2rem; font-weight:600; color:var(--navy); margin-bottom:8px;}
