  .why-list{display:flex; flex-direction:column; border-top:1px solid rgba(246,243,236,0.15);}
  .why-row{display:grid; grid-template-columns:60px 1fr; gap:18px; padding:24px 0; border-bottom:1px solid rgba(246,243,236,0.15);}
  .why-num{font-family:'IBM Plex Mono', monospace; color:var(--gold); font-size:0.85rem;}
  .why-row h4{font-family:'Newsreader', serif; font-size:1.1rem; font-weight:500; margin-bottom:6px;}
  .why-row p{color:rgba(246,243,236,0.65); font-size:0.9rem; max-width:56ch;}

  .pricing{text-align:center;}
  .price-card{background:#fff; border:1px solid var(--line); max-width:420px; margin:0 auto; padding:38px 32px; border-radius:2px;}
  .price-num{font-family:'Newsreader', serif; font-size:2.6rem; color:var(--navy);}
  .price-note{font-family:'IBM Plex Mono', monospace; font-size:0.72rem; color:var(--slate); margin-bottom:22px;}
  .price-list{text-align:left; list-style:none; margin-bottom:26px;}
