<style>
  :root{
    --navy:#0B1E3C; --navy-deep:#071427; --gold:#C9A24B; --gold-soft:#E4D3A3;
    --paper:#F6F3EC; --ink:#1C2230; --slate:#5F6675; --line:rgba(11,30,60,0.14); --radius:2px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{background:var(--paper); color:var(--ink); font-family:'Inter',sans-serif; font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased;}
  .display{font-family:'Newsreader', serif;} .mono{font-family:'IBM Plex Mono', monospace; letter-spacing:0.04em;}
  a{color:inherit;} img{max-width:100%; display:block;}
  .wrap{max-width:1120px; margin:0 auto; padding:0 28px;}
  a:focus-visible, button:focus-visible{outline:2px solid var(--gold); outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){ *{animation:none !important; transition:none !important;} }

  header{position:sticky; top:0; z-index:50; background:rgba(246,243,236,0.92); backdrop-filter:blur(6px); border-bottom:1px solid var(--line);}
  .nav{display:flex; align-items:center; justify-content:space-between; padding:18px 28px;}
  .brand{display:flex; align-items:center; gap:10px; font-family:'Newsreader', serif; font-weight:600; font-size:1.1rem; color:var(--navy);}
  .brand .seal{width:28px; height:28px; border-radius:50%; border:1.5px solid var(--gold); display:flex; align-items:center; justify-content:center; font-family:'IBM Plex Mono', monospace; font-size:0.62rem; color:var(--gold); flex-shrink:0;}
  .brand .seal-img{width:28px; height:28px; border-radius:50%; border:1.5px solid var(--gold); object-fit:cover; flex-shrink:0; background:#fff;}
  nav.links{display:flex; gap:26px; font-size:0.86rem; font-weight:500;}
  nav.links a{text-decoration:none; color:var(--slate); transition:color .2s;}
  nav.links a:hover, nav.links a.active{color:var(--navy);}
  .cta-small{background:var(--navy); color:var(--paper); padding:9px 18px; font-size:0.82rem; font-weight:600; text-decoration:none; border-radius:var(--radius); border:1px solid var(--navy); white-space:nowrap;}
  .mobile-hide{display:flex;}
  @media (max-width:760px){ .mobile-hide{display:none;} }

  .hero{background:linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%); color:var(--paper); padding:80px 0 90px; position:relative; overflow:hidden;}
  .hero::before{content:""; position:absolute; inset:0; background-image:repeating-linear-gradient(0deg, rgba(201,162,75,0.05) 0px, rgba(201,162,75,0.05) 1px, transparent 1px, transparent 42px); pointer-events:none;}
  .hero-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:56px; align-items:center; position:relative;}
  @media (max-width:900px){ .hero-grid{grid-template-columns:1fr; gap:44px;} }
  .eyebrow{font-family:'IBM Plex Mono', monospace; font-size:0.72rem; letter-spacing:0.14em; color:var(--gold-soft); text-transform:uppercase; margin-bottom:18px;}
  h1.hero-title{font-family:'Newsreader', serif; font-weight:500; font-size:clamp(2rem, 4.2vw, 3rem); line-height:1.18; letter-spacing:-0.01em; margin-bottom:20px;}
  h1.hero-title em{font-style:italic; color:var(--gold-soft);}
  .hero-sub{font-size:1.03rem; color:rgba(246,243,236,0.78); max-width:48ch; margin-bottom:32px;}
  .hero-actions{display:flex; gap:14px; flex-wrap:wrap;}
  .btn-primary{background:var(--gold); color:var(--navy-deep); font-weight:700; font-size:0.92rem; padding:14px 26px; text-decoration:none; border-radius:var(--radius); border:1px solid var(--gold); transition:transform .18s ease, box-shadow .18s ease; display:inline-block;}
  .btn-primary:hover{transform:translateY(-2px); box-shadow:0 10px 24px rgba(201,162,75,0.25);}
  .btn-ghost{color:var(--paper); font-weight:600; font-size:0.92rem; padding:14px 22px; text-decoration:none; border:1px solid rgba(246,243,236,0.35); border-radius:var(--radius); transition:border-color .18s ease, background .18s ease; display:inline-block;}
